{
  "uid": "os2-overview",
  "title": "OS2 Stack Overview",
  "tags": ["os2"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-1h", "to": "now"},
  "panels": [
    {
      "type": "row",
      "title": "Kubernetes & workloads",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0},
      "collapsed": false,
      "panels": []
    },
    {
      "type": "stat",
      "title": "Webapp ready",
      "gridPos": {"h": 4, "w": 4, "x": 0, "y": 1},
      "targets": [{"expr": "kube_deployment_status_replicas_available{namespace=\"apps\", deployment=\"webapp\"}", "refId": "A"}],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "value", "graphMode": "none"},
      "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}}
    },
    {
      "type": "stat",
      "title": "Webapp desired",
      "gridPos": {"h": 4, "w": 4, "x": 4, "y": 1},
      "targets": [{"expr": "kube_deployment_spec_replicas{namespace=\"apps\", deployment=\"webapp\"}", "refId": "A"}],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "value", "graphMode": "none"}
    },
    {
      "type": "stat",
      "title": "HPA current",
      "gridPos": {"h": 4, "w": 4, "x": 8, "y": 1},
      "targets": [{"expr": "kube_horizontalpodautoscaler_status_current_replicas{namespace=\"apps\", horizontalpodautoscaler=\"webapp\"}", "refId": "A"}],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "value", "graphMode": "none"}
    },
    {
      "type": "stat",
      "title": "Ingress ready",
      "gridPos": {"h": 4, "w": 4, "x": 12, "y": 1},
      "targets": [{"expr": "kube_deployment_status_replicas_available{namespace=\"ingress-nginx\", deployment=\"ingress-nginx-controller\"}", "refId": "A"}],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "value", "graphMode": "none"},
      "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}}
    },
    {
      "type": "stat",
      "title": "Containers ready",
      "gridPos": {"h": 4, "w": 4, "x": 16, "y": 1},
      "targets": [{"expr": "sum(kube_pod_container_status_ready{namespace=\"apps\", container!=\"POD\"})", "refId": "A"}],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "value", "graphMode": "none"}
    },
    {
      "type": "table",
      "title": "Pod / container status (apps)",
      "gridPos": {"h": 6, "w": 24, "x": 0, "y": 5},
      "targets": [{
        "expr": "kube_pod_container_status_ready{namespace=\"apps\", container!=\"POD\"}",
        "refId": "A",
        "format": "table",
        "instant": true
      }],
      "transformations": [
        {"id": "organize", "options": {"excludeByName": {"Time": true, "__name__": true, "container_id": true, "endpoint": true, "instance": true, "job": true, "service": true, "uid": true, "image": true, "image_id": true, "image_spec": true}, "renameByName": {"pod": "Pod", "container": "Container", "namespace": "Namespace", "Value": "Ready"}}}
      ],
      "fieldConfig": {"defaults": {"mappings": [{"type": "value", "options": {"0": {"text": "Not ready", "color": "red"}, "1": {"text": "Ready", "color": "green"}}}], "custom": {"displayMode": "color-text"}}}
    },
    {
      "type": "timeseries",
      "title": "HTTP request rate by webapp pod",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 11},
      "targets": [{
        "expr": "sum by (pod) (rate(http_requests_total{namespace=\"apps\", pod=~\"webapp-.*\"}[1m]) * on(pod, namespace) group_left() (kube_pod_status_phase{namespace=\"apps\", phase=\"Running\"} == 1))",
        "legendFormat": "{{pod}}",
        "refId": "A"
      }]
    },
    {
      "type": "timeseries",
      "title": "Ingress access log throughput (classifier)",
      "description": "Classifier sidecar on nginx-ingress counts JSON access log lines.",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 11},
      "targets": [{
        "expr": "rate(logs_processed_total{namespace=\"ingress-nginx\"}[1m])",
        "legendFormat": "logs/s",
        "refId": "A"
      }]
    },
    {
      "type": "row",
      "title": "Load & latency",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 19},
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "HTTP requests rate by handler",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 20},
      "targets": [{
        "expr": "sum by (handler) (rate(http_requests_total{namespace=\"apps\", pod=~\"webapp-.*\"}[1m]) * on(pod, namespace) group_left() (kube_pod_status_phase{namespace=\"apps\", phase=\"Running\"} == 1))",
        "legendFormat": "{{handler}}",
        "refId": "A"
      }]
    },
    {
      "type": "timeseries",
      "title": "Request duration p95",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 20},
      "targets": [{
        "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{namespace=\"apps\", pod=~\"webapp-.*\"}[5m]) * on(pod, namespace) group_left() (kube_pod_status_phase{namespace=\"apps\", phase=\"Running\"} == 1)) by (le))",
        "legendFormat": "p95",
        "refId": "A"
      }]
    },
    {
      "type": "row",
      "title": "Resources (apps namespace)",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 28},
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Container CPU",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 29},
      "targets": [{
        "expr": "sum by (pod, container) (rate(container_cpu_usage_seconds_total{namespace=\"apps\", container!=\"\", container!=\"POD\"}[1m]) * on(pod, namespace) group_left() (kube_pod_status_phase{namespace=\"apps\", phase=\"Running\"} == 1))",
        "legendFormat": "{{pod}}/{{container}}",
        "refId": "A"
      }]
    },
    {
      "type": "timeseries",
      "title": "Container memory",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 29},
      "targets": [{
        "expr": "sum by (pod, container) (container_memory_working_set_bytes{namespace=\"apps\", container!=\"\", container!=\"POD\"} * on(pod, namespace) group_left() (kube_pod_status_phase{namespace=\"apps\", phase=\"Running\"} == 1))",
        "legendFormat": "{{pod}}/{{container}}",
        "refId": "A"
      }]
    },
    {
      "type": "row",
      "title": "Security (classifier)",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 37},
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Classifier events by category",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 38},
      "targets": [{
        "expr": "sum by (category) (rate(log_events_total{namespace=\"ingress-nginx\"}[1m]))",
        "legendFormat": "{{category}}",
        "refId": "A"
      }]
    },
    {
      "type": "gauge",
      "title": "ML anomaly score",
      "gridPos": {"h": 8, "w": 4, "x": 12, "y": 38},
      "targets": [{"expr": "max(ml_anomaly_score{namespace=\"ingress-nginx\", pod=~\"ingress-nginx-controller-.*\"})", "legendFormat": "score", "refId": "A"}],
      "fieldConfig": {"defaults": {"min": 0, "max": 1, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 0.5}, {"color": "red", "value": 0.8}]}}}
    },
    {
      "type": "stat",
      "title": "Flagged IPs (DDoS)",
      "gridPos": {"h": 8, "w": 4, "x": 16, "y": 38},
      "targets": [{"expr": "sum(flagged_ips_total{namespace=\"ingress-nginx\", reason=\"ddos_suspect\"})", "legendFormat": "flagged IPs", "refId": "A"}],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "value", "graphMode": "none"},
      "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 1}, {"color": "red", "value": 5}]}}}
    },
    {
      "type": "timeseries",
      "title": "5xx events (via ingress logs)",
      "description": "Classifier tags HTTP 5xx from nginx JSON access logs.",
      "gridPos": {"h": 8, "w": 4, "x": 20, "y": 38},
      "targets": [{
        "expr": "sum(rate(log_events_total{namespace=\"ingress-nginx\", category=\"error_5xx\"}[1m]))",
        "legendFormat": "5xx/s",
        "refId": "A"
      }]
    }
  ]
}
